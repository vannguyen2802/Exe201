package com.example.nestera.Firebase;

import com.example.nestera.model.PhongTroImages;
import com.google.firebase.firestore.QueryDocumentSnapshot;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Repository cho PhongTroImages - đọc/ghi Firestore
 * Lưu URLs ảnh từ Firebase Storage
 */
public class PhongTroImagesRepository extends FirestoreRepository<PhongTroImages> {

    public PhongTroImagesRepository() {
        super("phongTroImages");
    }

    @Override
    protected PhongTroImages fromDocument(QueryDocumentSnapshot doc) {
        PhongTroImages img = new PhongTroImages();
        img.setId(doc.getLong("id") != null ? doc.getLong("id").intValue() : 0);
        img.setPhongId(doc.getLong("phongId") != null ? doc.getLong("phongId").intValue() : 0);
        
        // imagePath từ SQLite → imageUrl từ Firebase Storage
        String imageUrl = doc.getString("imageUrl");
        if (imageUrl == null || imageUrl.isEmpty()) {
            imageUrl = doc.getString("imagePath"); // fallback cho old data
        }
        img.setImagePath(imageUrl);
        
        return img;
    }

    @Override
    protected Map<String, Object> toDocument(PhongTroImages item) {
        Map<String, Object> map = new HashMap<>();
        map.put("id", item.getId());
        map.put("phongId", item.getPhongId());
        map.put("imageUrl", item.getImagePath()); // lưu URL từ Storage
        map.put("imagePath", item.getImagePath()); // giữ tên cũ cho compatibility
        return map;
    }

    /**
     * Lấy tất cả ảnh của một phòng
     */
    public void getByPhongId(int phongId, FirestoreCallback<List<PhongTroImages>> callback) {
        db.collection(collectionName)
                .whereEqualTo("phongId", phongId)
                .get()
                .addOnSuccessListener(querySnapshot -> {
                    List<PhongTroImages> list = new ArrayList<>();
                    for (QueryDocumentSnapshot doc : querySnapshot) {
                        list.add(fromDocument(doc));
                    }
                    callback.onSuccess(list);
                })
                .addOnFailureListener(callback::onError);
    }

    /**
     * Xóa tất cả ảnh của một phòng (khi xóa phòng)
     */
    public void deleteByPhongId(int phongId, FirestoreCallback<Void> callback) {
        db.collection(collectionName)
                .whereEqualTo("phongId", phongId)
                .get()
                .addOnSuccessListener(querySnapshot -> {
                    // Xóa từng document
                    for (QueryDocumentSnapshot doc : querySnapshot) {
                        doc.getReference().delete();
                    }
                    callback.onSuccess(null);
                })
                .addOnFailureListener(callback::onError);
    }

    /**
     * Lắng nghe real-time changes cho ảnh của một phòng
     */
    public void listenForChangesByPhongId(int phongId, FirestoreCallback<List<PhongTroImages>> callback) {
        db.collection(collectionName)
                .whereEqualTo("phongId", phongId)
                .addSnapshotListener((snapshots, error) -> {
                    if (error != null) {
                        callback.onError(error);
                        return;
                    }
                    
                    if (snapshots != null) {
                        List<PhongTroImages> list = new ArrayList<>();
                        for (QueryDocumentSnapshot doc : snapshots) {
                            list.add(fromDocument(doc));
                        }
                        callback.onSuccess(list);
                    }
                });
    }

    /**
     * Lắng nghe tất cả changes
     */
    public void listenForChanges(FirestoreCallback<List<PhongTroImages>> callback) {
        db.collection(collectionName)
                .addSnapshotListener((snapshots, error) -> {
                    if (error != null) {
                        callback.onError(error);
                        return;
                    }
                    
                    if (snapshots != null) {
                        List<PhongTroImages> list = new ArrayList<>();
                        for (QueryDocumentSnapshot doc : snapshots) {
                            list.add(fromDocument(doc));
                        }
                        callback.onSuccess(list);
                    }
                });
    }
}
